# Copia este archivo como .env y ajusta los valores.
# Codex no carga .env automáticamente: exporta las variables en tu shell
# (por ejemplo: set -a; source .env; set +a) o pásalas al arrancar.

# Base vectorial leída al iniciar (la tuya o la generada con tools/)
CHROMA_DB_PATH=./v20_db/chroma.sqlite3

# Colección chromem-go persistida (embeddings reutilizados entre arranques)
CHROMEM_DB_PATH=./codex_data/chromem

# Servidor OpenAI-compatible con endpoints /v1/chat/completions y /v1/embeddings
LLM_BASE_URL=http://192.168.100.100:8080/v1
EMBEDDING_BASE_URL=http://192.168.100.100:8080/v1

# Modelos (los embeddings deben tener el mismo preset en toda la colección)
LLM_MODEL=mradermacher/Qwen-3-VL-8B-Instruct-heretic-GGUF:Q4_K_M
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B-GGUF:F16

# API keys (los servidores locales suelen ignorarlas)
LLM_API_KEY=no-key-required
EMBEDDING_API_KEY=no-key-required

# Puerto del servidor web
PORT=3000
